{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quasar runtime tilemap version 1",
  "description": "Structural schema. Runtime validation additionally enforces GID ranges, unique IDs, exact grids and chunk cell counts, nonoverlap, finite dimensions, property types, asset paths and aggregate limits.",
  "type": "object",
  "properties": {
    "quasar_version": {
      "const": 1
    },
    "tile_width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "tile_height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "width": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "height": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "infinite": {
      "type": "boolean"
    },
    "background": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 4,
      "maxItems": 4
    },
    "tilesets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tileset"
      },
      "maxItems": 1024
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      },
      "maxItems": 1024
    },
    "properties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/property"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "quasar_version",
    "tile_width",
    "tile_height",
    "width",
    "height",
    "tilesets",
    "layers"
  ],
  "additionalProperties": false,
  "$defs": {
    "property": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "value": {},
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "properties": {
        "tile_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "tile_id",
        "duration_ms"
      ],
      "additionalProperties": false
    },
    "tile": {
      "type": "object",
      "properties": {
        "animation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "tileset": {
      "type": "object",
      "properties": {
        "first_gid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "name": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "image_width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "image_height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "tile_width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "tile_height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "columns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "tile_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "margin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "spacing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "tiles": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/tile"
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "first_gid",
        "name",
        "image",
        "image_width",
        "image_height",
        "tile_width",
        "tile_height",
        "columns",
        "tile_count"
      ],
      "additionalProperties": false
    },
    "chunk": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "maxItems": 4194304
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height",
        "cells"
      ],
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "name": {
          "type": "string"
        },
        "class": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "point": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "layer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "parallax": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "tint": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 4,
          "maxItems": 4
        },
        "content": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "tiles"
                },
                "chunks": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/chunk"
                  }
                }
              },
              "required": [
                "kind",
                "chunks"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "objects"
                },
                "objects": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/object"
                  }
                }
              },
              "required": [
                "kind",
                "objects"
              ],
              "additionalProperties": false
            }
          ]
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "content"
      ],
      "additionalProperties": false
    }
  }
}
